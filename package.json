{
  "name": "party-building-ledger",
  "private": true,
  "version": "3.4.0",
  "description": "党建工作台账应用 - 基层党组织会议记录与统计管理",
  "author": "Party Building",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/xlsx": "^0.0.35",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.2",
    "dayjs": "^1.11.21",
    "dexie": "^4.4.4",
    "docx": "^9.7.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "react-router-dom": "^7.18.1",
    "tslib": "^2.8.1",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "build": {
    "appId": "com.partybuilding.ledger",
    "productName": "党建工作台账",
    "directories": {
      "output": "build-output"
    },
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.svg",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "党建工作台账_${version}_绿色版.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "党建工作台账",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "unicode": true
    }
  }
}
